{
  "realm": "jungle",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "wallet-internal", "description": "Internal wallet service operations" }
    ]
  },
  "clientScopes": [
    {
      "name": "jungle-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-jungle-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "jungle-api",
      "name": "API audience (resource)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "jungle-internal",
      "name": "Internal wallet service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "jungle-internal-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["jungle-audience"]
    },
    {
      "clientId": "provider-a",
      "name": "Provider A",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["jungle-audience"],
      "protocolMappers": [
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-jungle-internal",
      "enabled": true,
      "serviceAccountClientId": "jungle-internal",
      "realmRoles": ["wallet-internal"]
    }
  ]
}
